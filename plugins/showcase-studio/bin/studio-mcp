#!/bin/sh
# Starts Showcase Studio as Claude Code's MCP server: the app's --mcp mode,
# talking MCP on stdin and stdout.
#
# It looks for the app at $SHOWCASE_STUDIO_APP, then in
# $SHOWCASE_STUDIO_INSTALL_DIR, ~/Applications and /Applications (on
# Linux: ~/.local/share/showcase-studio; on Windows: see below), and
# prefers the version this plugin expects (../app-version). With no app,
# it exits with a message naming bin/install-app, which installs it. A
# SHOWCASE_STUDIO_APP that names nothing is an error, not a fallback:
# the variable is how a local build is tried, and a session that quietly
# ran the installed app instead would test the wrong thing.
# Plain sh on purpose: Claude Code doesn't need Node, so this can't either.
#
# To run the studio from source instead, set SHOWCASE_STUDIO_SRC to a
# checkout of the studio repo (with npm i done). That runs the checkout's
# scripts/studio-mcp.mjs with Node 22 or later: $SHOWCASE_STUDIO_NODE, or
# the node on PATH. The app and its version are not checked.

root="$(cd "$(dirname "$0")/.." && pwd)"

if [ -n "${SHOWCASE_STUDIO_SRC:-}" ]; then
  script="$SHOWCASE_STUDIO_SRC/scripts/studio-mcp.mjs"
  if [ ! -f "$script" ]; then
    echo "showcase-studio: SHOWCASE_STUDIO_SRC is set, but $script doesn't exist. Point it at a Showcase Studio checkout." >&2
    exit 1
  fi
  node="${SHOWCASE_STUDIO_NODE:-$(command -v node)}"
  if [ -z "$node" ]; then
    echo "showcase-studio: SHOWCASE_STUDIO_SRC is set, but node isn't on PATH. Set SHOWCASE_STUDIO_NODE to a Node 22 binary." >&2
    exit 1
  fi
  major="$("$node" -p 'process.versions.node.split(".")[0]' 2> /dev/null)"
  if [ -z "$major" ] || [ "$major" -lt 22 ]; then
    echo "showcase-studio: $node is Node ${major:-unknown}; the studio needs Node 22 or later. Set SHOWCASE_STUDIO_NODE to a Node 22 binary." >&2
    exit 1
  fi
  exec "$node" "$script"
fi

want="$(tr -d '[:space:]' < "$root/app-version")"

# Windows, when Claude Code starts this script through Git Bash's sh
# (bin/studio-mcp.cmd covers the other way it may start the server). The
# app is a folder with Showcase Studio.exe in it, from bin/install-app.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*)
    if [ -n "${SHOWCASE_STUDIO_APP:-}" ] && [ ! -f "$(cygpath -u "$SHOWCASE_STUDIO_APP")" ] \
      && [ ! -f "$(cygpath -u "$SHOWCASE_STUDIO_APP/Showcase Studio.exe")" ]; then
      echo "showcase-studio: SHOWCASE_STUDIO_APP is set, but there is no Showcase Studio.exe at $SHOWCASE_STUDIO_APP. Unset it to use the installed app." >&2
      exit 1
    fi
    for exe in \
      "${SHOWCASE_STUDIO_APP:-}" \
      "${SHOWCASE_STUDIO_APP:+$SHOWCASE_STUDIO_APP/Showcase Studio.exe}" \
      "${SHOWCASE_STUDIO_INSTALL_DIR:+$SHOWCASE_STUDIO_INSTALL_DIR/Showcase Studio/Showcase Studio.exe}" \
      "${LOCALAPPDATA:+$LOCALAPPDATA/Programs/Showcase Studio/Showcase Studio.exe}"; do
      [ -n "$exe" ] || continue
      exe="$(cygpath -u "$exe")"
      [ -f "$exe" ] && exec "$exe" --mcp
    done
    echo "showcase-studio: the Showcase Studio app isn't installed. Install version $want with: \"$root/bin/install-app\"" >&2
    exit 1
    ;;
esac

# Linux: the tarball bin/install-app unpacks, with its launcher at
# bin/showcase-studio and its version in VERSION. SHOWCASE_STUDIO_APP may
# name the unpacked folder or the launcher itself.
if [ "$(uname -s)" = Linux ]; then
  app_dir=""
  if [ -n "${SHOWCASE_STUDIO_APP:-}" ]; then
    if [ -x "$SHOWCASE_STUDIO_APP/bin/showcase-studio" ]; then
      app_dir="$SHOWCASE_STUDIO_APP"
    elif [ -f "$SHOWCASE_STUDIO_APP" ] && [ -x "$SHOWCASE_STUDIO_APP" ]; then
      app_dir="$(cd "$(dirname "$SHOWCASE_STUDIO_APP")/.." && pwd)"
    else
      echo "showcase-studio: SHOWCASE_STUDIO_APP is set, but there is no Showcase Studio at $SHOWCASE_STUDIO_APP. Unset it to use the installed app." >&2
      exit 1
    fi
  fi
  found=""
  for dir in \
    "$app_dir" \
    "${SHOWCASE_STUDIO_INSTALL_DIR:+$SHOWCASE_STUDIO_INSTALL_DIR/showcase-studio}" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/showcase-studio"; do
    [ -n "$dir" ] && [ -x "$dir/bin/showcase-studio" ] || continue
    if [ "$(cat "$dir/VERSION" 2> /dev/null)" = "$want" ]; then
      found="$dir"
      break
    fi
    [ -n "$found" ] || found="$dir"
  done
  if [ -z "$found" ]; then
    echo "showcase-studio: Showcase Studio isn't installed. Install version $want with: \"$root/bin/install-app\"" >&2
    exit 1
  fi
  have="$(cat "$found/VERSION" 2> /dev/null)"
  if [ "$have" != "$want" ]; then
    echo "showcase-studio: $found is version ${have:-unknown}, but this plugin expects $want. Running it anyway; update it with: \"$root/bin/install-app\"" >&2
  fi
  exec "$found/bin/showcase-studio" --mcp
fi

version_of() {
  /usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "$1/Contents/Info.plist" 2> /dev/null
}

if [ -n "${SHOWCASE_STUDIO_APP:-}" ] && [ ! -x "$SHOWCASE_STUDIO_APP/Contents/MacOS/Showcase Studio" ]; then
  echo "showcase-studio: SHOWCASE_STUDIO_APP is set, but there is no app at $SHOWCASE_STUDIO_APP. Unset it to use the installed app." >&2
  exit 1
fi

found=""
for app in \
  "${SHOWCASE_STUDIO_APP:-}" \
  "${SHOWCASE_STUDIO_INSTALL_DIR:+$SHOWCASE_STUDIO_INSTALL_DIR/Showcase Studio.app}" \
  "$HOME/Applications/Showcase Studio.app" \
  "/Applications/Showcase Studio.app"; do
  [ -n "$app" ] && [ -x "$app/Contents/MacOS/Showcase Studio" ] || continue
  if [ "$(version_of "$app")" = "$want" ]; then
    found="$app"
    break
  fi
  [ -n "$found" ] || found="$app"
done

if [ -z "$found" ]; then
  echo "showcase-studio: the Showcase Studio app isn't installed. Install version $want with: \"$root/bin/install-app\"" >&2
  exit 1
fi

have="$(version_of "$found")"
if [ "$have" != "$want" ]; then
  echo "showcase-studio: $found is version ${have:-unknown}, but this plugin expects $want. Running it anyway; update it with: \"$root/bin/install-app\"" >&2
fi

exec "$found/Contents/MacOS/Showcase Studio" --mcp
