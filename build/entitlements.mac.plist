<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the signed app and everything inside
     it (electron-builder.yml: mac.entitlements / entitlementsInherit).
     Notarization requires the hardened runtime, and these three opt-outs
     are what Electron needs to run under it. -->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript to machine code at run time. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native modules (node-pty) and the bundled ffmpeg/esbuild/whisper
         binaries load libraries that aren't signed by Apple. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
