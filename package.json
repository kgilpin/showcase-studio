    "release:desktop": "npm run vendor:whisper && npm run build:desktop && node scripts/package-desktop.mjs && node scripts/electron-builder.mjs --mac && cd dist-electron/dist && shasum -a 256 Showcase-Studio-$npm_package_version-mac-arm64.zip > SHA256SUMS",
