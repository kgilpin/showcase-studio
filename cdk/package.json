{
  "name": "showcase-prompter-cdk",
  "private": true,
  "license": "Elastic-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never",
    "diff": "cdk diff",
    "synth:license": "cdk synth --app \"npx tsx bin/license.ts\" -o cdk.out.license",
    "diff:license": "cdk diff --app \"npx tsx bin/license.ts\" -o cdk.out.license",
    "deploy:license": "cdk deploy --app \"npx tsx bin/license.ts\" -o cdk.out.license"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
